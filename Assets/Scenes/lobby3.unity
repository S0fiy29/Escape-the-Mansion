--- !u!114 &1894343035
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1894343027}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd36620a718271b4b92318e9061ca1d9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 125367701}
  npcDialogueText: {fileID: 2007268810}
  playerDialoguePanel: {fileID: 321187908}
  playerDialogueText: {fileID: 1500880771}
  dialogue:
  - speaker: Hazil
    line: "Hey, Alice... I don\u2019t want to be rude, but is there really someone
      else besides you in this place?"
  - speaker: Hazil
    line: "If that question makes you feel uncomfortable, you can ignore it. I shouldn\u2019t
      have asked. My bad."
  - speaker: Alice
    line: "It\u2019s not that I\u2019m uncomfortable... But... it\u2019s complicated."
  - speaker: Hazil
    line: Complicated? What do you mean?
  - speaker: Alice
    line: "There are others... but not in the way you think. You might not meet them
      directly, but they\u2019ve been here... watching."
  - speaker: Hazil
    line: Watching? Who are they?
  - speaker: Alice
    line: "That\u2019s something you\u2019ll have to discover for yourself, Hazil.
      This place hides more than just objects... it hides people, memories, secrets."
  - speaker: Hazil
    line: "(Something\u2019s not right... she knows more than she\u2019s saying.)
      Alice... who are these people? Are they still alive?"
  - speaker: Alice
    line: "Alive? Some are, some aren\u2019t. But that doesn\u2019t matter here.
      You\u2019ll understand soon enough."
  npcContButton: {fileID: 1294271190}
  playerContButton: {fileID: 1889485997}
  wordSpeed: 0.05
  playerIsClose: 0
  isDialogueActive: 0
  playerMovement: {fileID: 1633259070}
