  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ahead lies the puzzle of the locked door and the chest that guards its
    key. But beware\u2014things are not as simple as they seem.\n\nThe door stands
    tall, silent, and unmoving, awaiting the key that will grant passage. Nearby,
    several chests rest in deceptive stillness, yet only one contains the key you
    need.\n\nChoose wisely, for some chests are mere decoys, meant to confuse and
    mislead. The true key is <color=#8d8a32>hidden </color>in a chest that will not
    reveal itself so easily. Look closely, listen carefully, and trust your instincts.
    Only through observation and patience can the door be unlocked.\n\nFail, and
    you may be trapped in this room for eternity, just like those who came before
    you."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
  m_sharedMaterial: {fileID: -6467807135178674435, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
