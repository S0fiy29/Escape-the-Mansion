MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1870424652}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 550e963110d6b014295bf513f00c9cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 545719695}
  npcDialogueText: {fileID: 1952348364}
  playerDialoguePanel: {fileID: 658882543}
  playerDialogueText: {fileID: 1773618466}
  dialogue:
  - speaker: Hazil
    line: This piano looks old but surprisingly well-preserved.
  - speaker: Cecilia
    line: It belonged to the Milady of this house.
  - speaker: Hazil
    line: Milady? You know her, Alice?
  - speaker: Cecilia
    line: "Of course, who wouldn\u2019t? She\u2019s an important figure in this family.
      Every staff member knows about her."
  - speaker: Hazil
    line: Oh, I see. (Mr. Jacob said he didn't know her... something feels off.)
  - speaker: Cecilia
    line: Are you alright, Mister?
  - speaker: Hazil
    line: Sorry, just got lost in thought. This piano still looks like it could play
      beautifully. Does Milady play it often?
  - speaker: Cecilia
    line: "Yes, she\u2019s very talented. The melodies she played would fill the
      entire hall."
  - speaker: Hazil
    line: Do you know how to play, Alice?
  - speaker: Cecilia
    line: "I\u2019m just average, really. Nothing compared to Milady."
  - speaker: Hazil
    line: "I\u2019d love to hear you play someday."
  - speaker: Cecilia
    line: "Unfortunately, we\u2019re not allowed to touch Milady\u2019s piano. It\u2019s
      one of the house rules."
  - speaker: Hazil
    line: Ah, I understand. Maybe we can find another piano somewhere in this mansion
      next time.
  - speaker: Cecilia
    line: "That would be nice. If we do, I\u2019ll play a tune for you."
  npcContButton: {fileID: 239235207}
  playerContButton: {fileID: 2049289161}
  wordSpeed: 0.05
  playerIsClose: 0
  isDialogueActive: 0
  playerMovement: {fileID: 1598006448}
  isTyping: 0
  inventoryButton: {fileID: 936773717}
  pauseButton: {fileID: 2058431839}
