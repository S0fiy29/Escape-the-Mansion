MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 486547477}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1bb02c8da6200b48aeb104391660cbd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1946511404}
  npcDialogueText: {fileID: 1776242021}
  playerDialoguePanel: {fileID: 2121445416}
  playerDialogueText: {fileID: 838331933}
  dialogue:
  - speaker: Hazil
    line: Hey Alice, are you ready to leave this place?
  - speaker: Cecilia
    line: Yeah... I just hope we can get out without any trouble.
  - speaker: Hazil
    line: "Don\u2019t worry, I\u2019ll make sure we get out safely. No one\u2019s
      going to stop us."
  - speaker: Cecilia
    line: "I trust you on that. But... please, let\u2019s not mention anything about
      our time in Milady\u2019s music room to anyone."
  - speaker: Hazil
    line: "Oh? Why\u2019s that?"
  - speaker: Cecilia
    line: If someone hears about it, they might punish you. That room is strictly
      off-limits to staff and guests.
  - speaker: Hazil
    line: "Seriously? That\u2019s intense. How did you even get in there?"
  - speaker: Cecilia
    line: I... was just curious. I wanted to see what it looked like.
  - speaker: Hazil
    line: Ah, I see. Curiosity killed the cat, right?
  - speaker: Cecilia
    line: Yeah... Something like that.
  - speaker: Hazil
    line: "Don\u2019t worry, I won\u2019t say a word about it. It\u2019ll be our
      little secret."
  - speaker: Cecilia
    line: Thanks, mister. I appreciate it.
  npcContButton: {fileID: 1631555356}
  playerContButton: {fileID: 974933395}
  wordSpeed: 0.05
  playerMovement: {fileID: 1598006448}
  npcManager: {fileID: 0}
  disable: {fileID: 0}
  enable: {fileID: 0}
  toActive: {fileID: 0}
  toDeactive: {fileID: 0}
