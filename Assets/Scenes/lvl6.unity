MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 190000646}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1bb02c8da6200b48aeb104391660cbd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1230116564}
  npcDialogueText: {fileID: 501545879}
  playerDialoguePanel: {fileID: 1888926769}
  playerDialogueText: {fileID: 1674189208}
  dialogue:
  - speaker: Hazil
    line: Alice???
  - speaker: Cecilia
    line: "Oh! It\u2019s you, Mister!"
  - speaker: Hazil
    line: "I\u2019ve been searching for you with Elana. We had to split up because
      Elana couldn't come with me."
  - speaker: Hazil
    line: Where have you been all this time?
  - speaker: Cecilia
    line: ...
  - speaker: Cecilia
    line: I'm sorry, Mister. I was wandering around and ended up in this room.
  - speaker: Hazil
    line: '(noticing her hesitation): (Why did she pause like that?)'
  - speaker: Hazil
    line: "I\u2019m just glad you\u2019re safe. I was really worried when we got
      separated in the basement."
  - speaker: Hazil
    line: There were shadows down there. Do you know anything about them?
  - speaker: Cecilia
    line: "Yes, everyone here knows about them. I\u2019ve just been cautious to avoid
      them."
  - speaker: Hazil
    line: I see... Do you still want to leave this place?
  - speaker: Cecilia
    line: Leave?
  - speaker: Hazil
    line: Yes, you mentioned before that you wanted to get out of here.
  - speaker: Cecilia
    line: ...Yes. I still want to leave this place.
  - speaker: Hazil
    line: Are you alright, Alice? You seem... off.
  - speaker: Cecilia
    line: "I\u2019m fine. Let\u2019s meet at the door in the northeast room."
  - speaker: Hazil
    line: "Alright, I\u2019ll meet you there."
  npcContButton: {fileID: 2114235420}
