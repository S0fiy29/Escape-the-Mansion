MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1598006442}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f13ca54006115e24bb77c1d39ff869a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 798992337}
  npcDialogueText: {fileID: 1879439177}
  playerDialoguePanel: {fileID: 287727306}
  playerDialogueText: {fileID: 678158318}
  dialogue:
  - speaker: Hazil
    line: Wow! What a huge hall!
  - speaker: Elana
    line: "Welcome to the Hayes family's secondary hall. It\u2019s the second largest
      after the main hall."
  - speaker: Hazil
    line: "What?! This is just the secondary hall? It\u2019s still massive!"
  - speaker: Elana
    line: Yes, it is. We have a lot of staff here; it takes a lot of hands to keep
      this mansion running smoothly.
  - speaker: Hazil
    line: "I can see why. This family must have a lot of money to hire so many people.
      (No wonder Elana didn\u2019t recognize Alice right away; with so many staff,
      it's hard to keep track of everyone.)"
  - speaker: Elana
    line: "Let\u2019s look for Mr. Jacob. I wonder where he might be now."
  - speaker: Hazil
    line: Yeah, let's find him. Hopefully, he can help us unravel some of these mysteries.
  npcContButton: {fileID: 1983488610}
  playerContButton: {fileID: 1200947047}
  wordSpeed: 0.05
  playerMovement: {fileID: 1598006448}
  isTyping: 0
  inventoryButton: {fileID: 936773717}
  pauseButton: {fileID: 2058431839}
