--- !u!114 &1785969097
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1785969096}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 37171f0ed2d9d3f49b2194e5c650a179, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1341970599}
  npcDialogueText: {fileID: 1804749202}
  playerDialoguePanel: {fileID: 934313262}
  playerDialogueText: {fileID: 127244420}
  dialogue:
  - speaker: Elana
    line: "I\u2019m sorry, Hazil. This is as far as I can go with you. From here
      on, it\u2019s up to you."
  - speaker: Hazil
    line: "No worries, Elana. I get it. With Mr. Jacob having already found Milady,
      there\u2019s no reason for you to keep searching with me."
  - speaker: Elana
    line: Yes, now that Milady has been found by Mr. Jacob, I need to return to take
      care of her.
  - speaker: Hazil
    line: "It\u2019s alright; it\u2019s part of your duty, after all. But still...
      Mr. Jacob said he never heard about Alice. Something feels off about that."
  - speaker: Hazil
    line: (Is there a hidden meaning behind his words, or is it just my imagination?)
  - speaker: Hazil
    line: Elana, I guess this is where we part ways. Thank you for helping me navigate
      through that floor and for searching for Alice with me.
  - speaker: Elana
    line: No problem, Hazil. I hope you find Alice and manage to get out of here
      safely.
  - speaker: Elana
    line: "Oh, before I go, there\u2019s a rumor I heard among the staff... They
      say there\u2019s a child who often wanders around the mansion."
  - speaker: Elana
    line: "Perhaps that child is the one you\u2019re looking for."
  - speaker: Hazil
    line: A wandering child? That could be a lead. Thank you, Elana. That information
      could be a big help.
  - speaker: Elana
    line: "You\u2019re welcome. Good luck on your journey, Hazil. I hope you find
      the answers you\u2019re looking for."
  npcContButton: {fileID: 1983488610}
  playerContButton: {fileID: 1200947047}
  wordSpeed: 0.05
  playerMovement: {fileID: 1598006448}
  inventoryButton: {fileID: 936773717}
  pauseButton: {fileID: 2058431839}
