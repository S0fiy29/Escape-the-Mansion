  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 1186821543}
  dialogueText: {fileID: 14107406}
  dialogueLines:
  - "\u201CThe next floor... darker and more challenging...\u201D"
  - "Great. As if things weren\u2019t bad enough already."
  - "But I\u2019ve made it this far. I can\u2019t stop now."
  - "Whoever wrote this wasn\u2019t lying\u2014the challenges have only gotten worse.
    And now... the darkness will make it harder to see what\u2019s real."
  - "I need to keep going. No turning back. Alice is out there, and I\u2019ve got
    to solve this before it\u2019s too late."
  - "Alright... Let\u2019s see what this next floor has in store for me."
  wordSpeed: 0.05
