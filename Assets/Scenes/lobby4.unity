--- !u!114 &207328329
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 207328324}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 37171f0ed2d9d3f49b2194e5c650a179, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1501913643}
  npcDialogueText: {fileID: 1119328180}
  playerDialoguePanel: {fileID: 267867673}
  playerDialogueText: {fileID: 343039105}
  dialogue:
  - speaker: Elana
    line: Ah!
  - speaker: Hazil
    line: "Whoa, sorry! I didn\u2019t mean to scare you. Are you alright?"
  - speaker: Elana
    line: "Y-you... you're the man from the last floor?"
  - speaker: Hazil
    line: "It\u2019s me, Hazil. We met earlier on the previous floor. You mentioned
      you were looking for Milady, right? Looks like you got stuck here?"
  - speaker: Elana
    line: "Yes... I\u2019ve been locked in here for a while. I was searching for
      Milady, but the door suddenly shut behind me."
  - speaker: Hazil
    line: "This mansion is really something... things just keep getting stranger.
      I was with someone\u2014Alice, a girl\u2014but she went missing. Now I need
      to find her."
  - speaker: Elana
    line: "I haven\u2019t met anyone by that name. I don\u2019t think I\u2019ve seen
      a girl like her in the mansion before..."
  - speaker: Hazil
    line: "That\u2019s strange. I was sure she\u2019d be around here somewhere..."
  - speaker: Hazil
    line: '[A brief silence as Hazil processes this new information.]'
  - speaker: Hazil
    line: By the way, I never got your name earlier.
  - speaker: Elana
    line: "It\u2019s Elana. I\u2019m one of the maids here."
  - speaker: Hazil
    line: "Elana... Thanks for telling me. I\u2019m Hazil, by the way."
  - speaker: Elana
    line: "Thank you, Hazil. If you hadn\u2019t opened that door... I don\u2019t
      know how long I would\u2019ve been trapped in here."
  - speaker: Hazil
    line: "Don\u2019t mention it. I\u2019m just glad I could help."
  - speaker: Elana
    line: "If you\u2019re still searching for Alice, maybe we could help each other.
      I need to find Milady, and it sounds like we\u2019re both trying to make sense
      of this place."
  - speaker: Hazil
    line: "That sounds like a good idea. We could use each other\u2019s help."
  - speaker: Elana
    line: "Then it\u2019s a deal. We\u2019ll find Alice, and Milady, together."
  - speaker: Hazil
    line: "Alright. Let\u2019s get moving before something else goes wrong."
  npcContButton: {fileID: 651184608}
  playerContButton: {fileID: 112224736}
  wordSpeed: 0.05
  playerMovement: {fileID: 25115699}
  inventoryButton: {fileID: 1989472701}
  pauseButton: {fileID: 911151681}
