  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1882661048}
  npcDialogueText: {fileID: 389809777}
  playerDialoguePanel: {fileID: 1960713283}
  playerDialogueText: {fileID: 247655979}
  dialogue:
  - speaker: Cecilia
    line: I think this is as far as I can go. The rest is up to you, Hazil.
  - speaker: Hazil
    line: Huh? What do you mean, Cecilia?
  - speaker: Cecilia
    line: You know... I'm not even human, Hazil. I'm a spirit.
  - speaker: Hazil
    line: ...
  - speaker: Cecilia
    line: "Don\u2019t worry about me. I\u2019ve been yearning for eternal rest\u2014I\u2019m
      so tired of it all."
  - speaker: Cecilia
    line: All the spirits trapped in the mansion are finally free, and my sister
      has regained her consciousness.
  - speaker: Cecilia
    line: "She\u2019s now at peace, resting alongside the others."
  - speaker: Hazil
    line: So... this is the end of the nightmare for both of you.
  - speaker: Cecilia
    line: "Yes, it is. Thank you for everything, Hazil. Without your help, I couldn\u2019t
      have freed everyone."
  - speaker: Hazil
    line: " ...You\u2019re welcome. I hope you can finally rest in peace after all
      of this."
  - speaker: Cecilia
    line: Hahaha, thank you for humoring me, mister. And goodbye, Hazil.
  - speaker: Hazil
    line: Goodbye, Cecilia.
  npcContButton: {fileID: 1745408709}
  playerContButton: {fileID: 439149091}
  wordSpeed: 0.05
  playerMovement: {fileID: 137458363}
  gameOverPanel: {fileID: 1068407418}
  button: {fileID: 700222582}
  inventoryButton: {fileID: 0}
  pauseButton: {fileID: 700222582}
