MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 596647392}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a50cd5bbb43027640b4955ab829e34b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 2099258862}
  npcDialogueText: {fileID: 596901152}
  playerDialoguePanel: {fileID: 1466995008}
  playerDialogueText: {fileID: 1957249984}
  dialogue:
  - speaker: Hazil
    line: "(checking his phone) Hmm\u2026 wait! My phone has a signal?"
  - speaker: Hazil
    line: "The battery\u2019s low, I need to make a quick call."
  - speaker: Hazil
    line: I have to report this to Mr. Abraham. Please, let it go through.  (Phone
      ringing...)
  - speaker: Mr. Abraham
    line: Hello? Who is calling me?
  - speaker: Hazil
    line: "Mr. Abraham, it\u2019s me, Hazil! I need to report something unbelievable
      about the abandoned mansion!"
  - speaker: Mr. Abraham
    line: Is this a prank call? Hazil has been missing for eight years. Who are you?
  - speaker: Hazil
    line: What?! What do you mean, missing for eight years?!
  - speaker: Mr. Abraham
    line: Yes, the Hazil you mention disappeared eight years ago while investigating
      the abandoned mansion. No one has heard from him since.
  - speaker: Hazil
    line: "No! Mr. Abraham, it\u2019s really me! I\u2019m alive, calling you now.
      Don\u2019t you recognize my voice?!"
  - speaker: Mr. Abraham
    line: "I\u2019m sorry, but I can\u2019t believe this. If this is a prank, it\u2019s
      not funny. Please don\u2019t call me again."
  - speaker: Mr. Abraham
    line: Goodbye.  (The call ends abruptly...)
  - speaker: Hazil
    line: "Wait! Mr. Abraham! Don\u2019t hang up!"
  - speaker: Hazil
    line: "(stares at the phone, trembling) He hung up\u2026"
  - speaker: Hazil
    line: (laughs nervously) Missing for eight years? Am I a dead man now?
  - speaker: Hazil
    line: "Please\u2026 tell me this isn\u2019t true..."
  - speaker: Hazil
    line: "(clenching his fists) What\u2019s the point of escaping if eight years
      of my life are gone?!"
  - speaker: Hazil
    line: "Just you wait, I\u2019ll prove I didn\u2019t disappear like that. I\u2019m
      alive, and I\u2019ll make everyone see it!"
