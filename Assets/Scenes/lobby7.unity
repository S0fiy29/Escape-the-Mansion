  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A happy ending? Ha-ha-ha, what nonsense am I talking about... I\u2019ve
    never been able to leave this place. Every time I get close, she drags me back
    in. It\u2019s like I\u2019m trapped in a birdcage, forever bound to this dark
    prison, never seeing the true light of freedom. The worst part is the hope\u2014it\u2019s
    always there, lingering, taunting me with the illusion of escape. But it\u2019s
    fake, all of it. Please... someone, anyone, get me out of here. Don\u2019t leave
    me clinging to false hope.\n\n\n\n-CC"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
