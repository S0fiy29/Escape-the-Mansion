  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Hayes family was renowned for their immense wealth, their fortune
    estimated to be beyond any calculable value. With their vast resources, they
    could acquire anything they desired, from rare antiques to lavish properties\u2014nothing
    was beyond their reach.\n\nThe family consisted of four members: the parents
    and their two daughters. The sisters were both healthy, yet while one was vibrant
    and full of energy, her sibling had notably less stamina. Despite this difference,
    the two shared a close bond, complementing each other\u2019s strengths and weaknesses
    as they grew up in the grandeur of the Hayes estate.\n\n- The Note Keeper"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
