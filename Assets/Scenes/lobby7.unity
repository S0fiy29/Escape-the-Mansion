  m_Script: {fileID: 11500000, guid: 550e963110d6b014295bf513f00c9cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 659337769}
  npcDialogueText: {fileID: 51724688}
  playerDialoguePanel: {fileID: 2019260407}
  playerDialogueText: {fileID: 1496925380}
  dialogue:
  - speaker: Hazil
    line: "Wait a minute... this note says the Hayes family had four members, not
      three. What\u2019s going on, Alice?"
  - speaker: Cecilia
    line: ...
  - speaker: Hazil
    line: "Everyone I\u2019ve spoken to mentioned that the Hayes family only had
      three members. Now I\u2019m completely lost. Which version is the truth? Is
      there something you\u2019re not telling me?"
  - speaker: Cecilia
    line: "I\u2019m sorry, mister. I can\u2019t reveal anything more. This is something
      you\u2019ll need to uncover on your own. The history of the Hayes family is
      tangled... and filled with secrets."
  - speaker: Hazil
    line: " ...This mansion is full of mysteries, and now even the history of the
      Hayes family feels like a puzzle I can\u2019t solve."
  - speaker: Cecilia
    line: I know. I just hope we can find our way out of here soon.
  - speaker: Hazil
    line: "Yeah... let\u2019s keep moving for now. The answers will have to wait."
  npcContButton: {fileID: 1144363056}
  playerContButton: {fileID: 2087505657}
  wordSpeed: 0.05
  playerIsClose: 0
  isDialogueActive: 0
  playerMovement: {fileID: 731261279}
  isTyping: 0
