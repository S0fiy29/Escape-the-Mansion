MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 598180108}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1bb02c8da6200b48aeb104391660cbd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 455655194}
  npcDialogueText: {fileID: 435531122}
  playerDialoguePanel: {fileID: 1124346044}
  playerDialogueText: {fileID: 1863023963}
  dialogue:
  - speaker: Hazil
    line: Hey, Elana, do you know about any dangerous entity on this floor? I read
      some papers that were left behind, and they mention something about it. It's
      got me worried.
  - speaker: Elana
    line: ...So, you found the papers. I hoped you wouldn't.
  - speaker: Hazil
    line: "What? So it\u2019s true, then? There\u2019s something out there?"
  - speaker: Elana
    line: "Yes. It\u2019s not just rumors, Hazil. There\u2019s something on this
      floor... something that watches us from the shadows."
  - speaker: Hazil
    line: What kind of thing are we dealing with?
  - speaker: Elana
    line: "I don't know exactly what it is, but I\u2019ve heard the stories from
      the head butler. He warned us all... If it catches you, you become like them\u2014lost
      forever in the dark."
  - speaker: Hazil
    line: Lost... forever?
  - speaker: Elana
    line: "The only way to stay safe is to find a light source. They can\u2019t come
      near it. But light is scarce on this floor."
  - speaker: Hazil
    line: "This is bad... There\u2019s hardly any light around here!"
  - speaker: Elana
    line: "Exactly. We need to be cautious, Hazil. Stay close to any light you find,
      and don\u2019t stray too far. If they catch you... there\u2019s no escape."
  - speaker: Elana
    line: "And there's something else, Hazil. The staff say this house is cursed. People who stay too long start to forget things, or remember them wrong."
  - speaker: Hazil
    line: "Cursed... and memories I can't trust. I'll keep that in mind."
  npcContButton: {fileID: 902617899}
  playerContButton: {fileID: 1861696042}
