MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 549494118}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1bb02c8da6200b48aeb104391660cbd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1770959451}
  npcDialogueText: {fileID: 280132257}
  playerDialoguePanel: {fileID: 427797520}
  playerDialogueText: {fileID: 663927913}
  dialogue:
  - speaker: Hazil
    line: "Oh! Sorry, I didn\u2019t mean to startle you... Who are you looking for?"
  - speaker: Elana
    line: "I\u2014I\u2019m looking for milady of the house... I must find her."
  - speaker: Hazil
    line: Milady? Who is she?
  - speaker: Elana
    line: "We don\u2019t... call her by name. Everyone here knows her as \u201Cmilady.\u201D"
  - speaker: Hazil
    line: "Milady? (pauses) But wait\u2014this mansion\u2019s supposed to be abandoned...
      right?"
  - speaker: Elana
    line: "Abandoned? This place? No... it\u2019s not abandoned at all.  I don\u2019t
      understand why you would think that."
  - speaker: Hazil
    line: "What?! But... everything I\u2019ve heard... You\u2019re saying it\u2019s
      not abandoned?"
  - speaker: Elana
    line: "You\u2019ll have to figure that out for yourself. I must go. I can\u2019t
      stay here. (she disappears down the corridor, leaving Hazil standing in confusion)"
  - speaker: Hazil
    line: What was that all about...?
  npcContButton: {fileID: 1648746640}
  playerContButton: {fileID: 1146445801}
  wordSpeed: 0.05
  playerMovement: {fileID: 294971842}
  npcManager: {fileID: 710601720}
