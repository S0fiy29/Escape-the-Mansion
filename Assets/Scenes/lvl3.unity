MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 591330359}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 550e963110d6b014295bf513f00c9cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1115191330}
  npcDialogueText: {fileID: 2025021359}
  playerDialoguePanel: {fileID: 2116310907}
  playerDialogueText: {fileID: 1368500594}
  dialogue:
  - speaker: Hazil
    line: 'What is this place...? Trapped? Mechanisms to prevent escape? '
  - speaker: Hazil
    line: And this milady... no one knows her real name?
  - speaker: Hazil
    line: "I have to find her. She\u2019s the key to getting out of here."
  - speaker: Hazil
    line: But who can I trust? The letter warns about others watching...
  - speaker: Hazil
    line: Where were you, Alice?
  - speaker: Hazil
    line: "I met that girl, Elana, but you weren\u2019t there. Why didn\u2019t you
      come with me?"
  - speaker: Alice
    line: "I was... I didn\u2019t know you were going to meet someone."
  - speaker: Hazil
    line: But you said you felt something was off about this place. I thought you
      would want to find out more.
  - speaker: Hazil
    line: "That letter says we can\u2019t trust everyone, and now I\u2019m left wondering
      if she was one of them."
  - speaker: Hazil
    line: "Do you know anything about her? Or why I didn\u2019t see you there?"
  - speaker: Alice
    line: "No, I don\u2019t know her. I... I thought you were alone."
  - speaker: Hazil
    line: "I can\u2019t shake this feeling that something bigger is at play here.
      We need to stick together, Alice."
  - speaker: Hazil
    line: If this letter is right, we need to figure out how to find milady and get
      out of this mansion.
  - speaker: Alice
    line: "I\u2019ll help you, Hazil. I don\u2019t want to be here any longer than
      necessary."
  - speaker: Hazil
    line: "Let\u2019s see what secrets lie behind these doors. Together."
  npcContButton: {fileID: 656220514}
  playerContButton: {fileID: 521726637}
