  m_Script: {fileID: 11500000, guid: 7da76348f51840f44b66e5c73f635a15, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 64230686}
  dialogueText: {fileID: 444701375}
  dialogueLines:
  - "What? There are two girls\u2014one who wants to lead people to escape and another
    who traps them?"
  - "I\u2019ve already met two girls, Elana and Alice. But they don\u2019t seem alike
    at all."
  - "The note keeper said I have to pretend I don\u2019t know about this if I want
    to escape from here."
  - My bigger problem is Alice. Her memory seems to get worse every time we try to
    escape.
  - "It\u2019s like her personality keeps changing, too."
  - "For now, I\u2019ll keep this to myself. I need to play along to make sure nothing
    goes wrong."
  wordSpeed: 0.05
  continueButton: {fileID: 1667426722}
  playerMovement: {fileID: 231085256}
  npcSprite: {fileID: 172133991}
  inventoryButton: {fileID: 1823383437}
  pauseButton: {fileID: 695747591}
