  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "There exists an artifact, dark and cursed, capable of bending the will
    of its holder. A relic that whispers deceit, it should have never crossed the
    threshold of this mansion. Yet, the Hayes family, blinded by arrogance, ignored
    the warnings that were uttered in grave tones.\n\nAnd then, the disaster unfolded.\n\nThe
    artifact claimed its victim, corrupting the mind of one of the Hayes children.
    Under its influence, she unleashed unspeakable carnage\u2014a shadow moving in
    the night, slaughtering the exhausted inhabitants of the mansion. The brutality
    was beyond imagination, the halls stained with silence and horror."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
  m_sharedMaterial: {fileID: -6467807135178674435, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
