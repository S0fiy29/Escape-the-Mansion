--- !u!114 &172133996
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 172133991}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 37171f0ed2d9d3f49b2194e5c650a179, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 372498733}
  npcDialogueText: {fileID: 1855631707}
  playerDialoguePanel: {fileID: 348709987}
  playerDialogueText: {fileID: 1084998453}
  dialogue:
  - speaker: Hazil
    line: Wow! Alice, where did you come from?
  - speaker: Alice
    line: ' I just came to find you since you went missing after we teleported.'
  - speaker: Hazil
    line: "??? How did you even know I was here? I didn\u2019t even know where you
      were."
  - speaker: Alice
    line: "Well, you could say I just had a feeling you\u2019d be here."
  - speaker: Alice
    line: Where were you, mister? I just saw you coming out of that room.
  - speaker: Hazil
    line: "(Why is she suddenly so curious about that room? I\u2019d better act like
      it\u2019s nothing important.)"
  - speaker: Hazil
    line: "Oh, yeah, I went in there, but I didn\u2019t find anything. I was actually
      looking for you."
  - speaker: Alice
    line: "Hmm... I see. Well, it can\u2019t be helped that we got separated, but
      now we\u2019re back together."
  - speaker: Alice
    line: "Let\u2019s head to the next floor, mister!"
  npcContButton: {fileID: 46139717}
  playerContButton: {fileID: 1058841185}
  wordSpeed: 0.05
  playerMovement: {fileID: 231085256}
  inventoryButton: {fileID: 1823383437}
  pauseButton: {fileID: 695747591}
