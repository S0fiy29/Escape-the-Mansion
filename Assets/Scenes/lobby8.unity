  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I was one of the few survivors\u2014a keeper of truth amidst the shadows.
    But my time is short, for she is hunting me. That girl, shrouded in danger, seeks
    to destroy what I have hidden.  \r\n\r\nI have left behind crucial evidence.
    To protect it, I created a safe room secured by a secret key\u2014a sanctuary
    that only the clever can access. Its purpose is clear: to keep her out and to
    ensure the evidence remains untouched.  \r\n\r\nTo anyone reading this note,
    I beg you, tread carefully. Beware the young girl, for her innocence is a veil
    for her true nature. She is a threat, and crossing her path may seal your fate. 
    \r\n\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
