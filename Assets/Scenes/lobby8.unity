  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "But now\u2026 I am nothing more than your puppet, another plaything in
    your twisted game. Please, stop. I beg you. I can\u2019t bear it anymore.\n\nI
    no longer want to be your \"milady.\" I just want someone\u2014anyone\u2014to
    call me by my name, the name that feels like it\u2019s slipping away with each
    passing moment.\n\nMy name is\u2026 Ceci\u2014\n\n- CC"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
  m_sharedMaterial: {fileID: -6467807135178674435, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
