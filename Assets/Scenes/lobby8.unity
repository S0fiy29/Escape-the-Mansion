  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I can no longer save her. The cursed artifact has consumed her entirely.
    Oh, my poor twin sister Al\u2014... I have failed you. I failed to protect you
    from the evil lurking in that storage room. If only I had stopped you from entering\u2026
    if only I had kept you away from that cursed item, this nightmare would have
    never unfolded.\n\nThis madness\u2026 it\u2019s my fault. I allowed you to succumb
    to the artifact's wicked grasp. I regret it deeply, and I\u2019m so, so sorry,
    my sister."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
  m_sharedMaterial: {fileID: -6467807135178674435, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
