--- !u!114 &451635738
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 451635737}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 550e963110d6b014295bf513f00c9cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 161351196}
  npcDialogueText: {fileID: 670161460}
  playerDialoguePanel: {fileID: 1362945572}
  playerDialogueText: {fileID: 304136049}
  dialogue:
  - speaker: Hazil
    line: ' "This key must be used wisely. Once the choice is made, there will be
      no turning back. Beware what lies beyond."'
  - speaker: Elana
    line: "What does that mean? \"No turning back\"? That doesn\u2019t sound good..."
  - speaker: Hazil
    line: "I\u2019m not sure, but it feels like a warning. (he grips the key, contemplating)"
  - speaker: Elana
    line: "But we don\u2019t have a choice, do we? We need to move forward to find
      Alice and Milady."
  - speaker: Hazil
    line: "Yeah, but this note... it\u2019s like someone\u2019s telling us that once
      we use this key, there\u2019s no going back. Are you ready for that?"
  - speaker: Elana
    line: "If it means finding Milady, then I don\u2019t care about the risks. We
      can\u2019t turn back now."
  - speaker: Hazil
    line: "You\u2019re right. We\u2019ve come too far to stop here. But we have to
      be smart about this. Whoever left this message knew what they were talking
      about. (he stares at the key)"
  - speaker: Elana
    line: "I\u2019m with you, Hazil. Let\u2019s be careful, but we can\u2019t let
      fear stop us."
  - speaker: Hazil
    line: "Alright then.  We\u2019ll move forward, but we\u2019ll keep our guard
      up. Whatever lies ahead... we\u2019ll face it together."
  npcContButton: {fileID: 546791533}
  playerContButton: {fileID: 702970083}
  wordSpeed: 0.05
  playerIsClose: 0
  isDialogueActive: 0
  playerMovement: {fileID: 1927521802}
  isTyping: 0
