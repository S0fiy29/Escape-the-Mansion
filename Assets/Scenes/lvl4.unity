MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 879349866}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 37171f0ed2d9d3f49b2194e5c650a179, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1986963528}
  npcDialogueText: {fileID: 1905528646}
  playerDialoguePanel: {fileID: 1405209078}
  playerDialogueText: {fileID: 340702074}
  dialogue:
  - speaker: Elana
    line: Hazil, are we... trapped in here? There are just so many boxes everywhere.
  - speaker: Hazil
    line: "Impossible. There has to be a way out of here. Maybe there\u2019s something
      we\u2019re missing\u2014a clue we haven\u2019t noticed yet."
  - speaker: Elana
    line: "A clue? All I can see are these boxes... they\u2019re made of different
      materials, but nothing really stands out."
  - speaker: Hazil
    line: "Wait... different materials, you said? That could be important. Maybe
      one of these boxes holds something useful\u2014a key or a message, perhaps."
  - speaker: Elana
    line: Are you sure about this, Hazil? It feels... risky to rely on just a hunch.
  - speaker: Hazil
    line: "Trust me, Elana. My gut\u2019s never let me down before. We\u2019ve got
      to check these boxes\u2014there might be something hidden among them."
  - speaker: Elana
    line: "Alright... I\u2019ll trust your instincts. Let\u2019s hope they\u2019re
      right this time."
  - speaker: Hazil
    line: "They will be. We\u2019ve come too far to get stuck now."
  npcContButton: {fileID: 1555292978}
  playerContButton: {fileID: 586784393}
  wordSpeed: 0.05
  playerMovement: {fileID: 1927521802}
  inventoryButton: {fileID: 735623962}
  pauseButton: {fileID: 437811247}
