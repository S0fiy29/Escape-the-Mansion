  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'To the one who finds this,


    Be warned, this mansion is far from empty.
    There are three of us still trapped within its walls, wandering in the shadows.
    We remain hidden, each of us with our own burdens to bear.


    A maid, ever
    in search of her elusive Milady, never speaking of her true intentions.


    A
    butler, whose quiet presence watches every corner, but says little of the secrets
    he holds.


    And a child, lost and frightened, appearing when you least expect,
    vanishing just as quickly.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
