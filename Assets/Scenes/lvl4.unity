--- !u!114 &1927521804
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1927521797}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f13ca54006115e24bb77c1d39ff869a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 933017230}
  npcDialogueText: {fileID: 1554528574}
  playerDialoguePanel: {fileID: 1245458046}
  playerDialogueText: {fileID: 1229883426}
  dialogue:
  - speaker: Hazil
    line: "Wow... this is no joke. The message wasn\u2019t kidding when it said the
      floor would become completely dark. I can barely see anything."
  - speaker: Elana
    line: "It feels... eerie. Like something\u2019s watching us."
  - speaker: Hazil
    line: "Yeah, I know what you mean. We need to be more careful here. There\u2019s
      no telling what\u2019s ahead, and we don\u2019t want to get caught off guard."
  - speaker: Elana
    line: "I don\u2019t like this... Not at all."
  - speaker: Hazil
    line: "Neither do I. But we\u2019ve made it this far, and we can\u2019t turn
      back now. Let\u2019s keep an eye out for any clues\u2014anything that might
      help us figure out what\u2019s going on or how to get through this."
  - speaker: Elana
    line: Right... we just have to stay together and not lose focus.
  - speaker: Hazil
    line: "Exactly. If the message was right, then we\u2019re in for tougher challenges.
      But we\u2019ll make it through this. We just have to be smart, stay alert,
      and keep moving forward."
  - speaker: Elana
    line: "Let\u2019s hope we find the next clue soon... before the darkness becomes
      too much."
  - speaker: Hazil
    line: "Yeah... we don\u2019t have much time. Let\u2019s go."
  npcContButton: {fileID: 69967799}
  playerContButton: {fileID: 1070163992}
  wordSpeed: 0.05
  playerMovement: {fileID: 1927521802}
  isTyping: 0
  inventoryButton: {fileID: 735623962}
  pauseButton: {fileID: 437811247}
