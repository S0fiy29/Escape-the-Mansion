  m_Script: {fileID: 11500000, guid: 0b4476788ca923842ad27e9edc2705e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1473236403}
  npcDialogueText: {fileID: 201842434}
  npcDialoguePanel2: {fileID: 674473377}
  npcDialogueText2: {fileID: 571101027}
  playerDialoguePanel: {fileID: 1262618151}
  playerDialogueText: {fileID: 1159170429}
  npcContButton: {fileID: 2107931105}
  npcContButton2: {fileID: 737493348}
  playerContButton: {fileID: 1223581182}
  dialogue:
  - speaker: Alice
    line: "What have you done?! You shouldn\u2019t have touched the antique item!"
  - speaker: Alice
    line: Hazil, why did you do it?!
  - speaker: Hazil
    line: "I\u2019m sorry, Alice, but to escape from here, I have to take this item
      and destroy it."
  - speaker: Hazil
    line: "This item is keeping us trapped here. If we don\u2019t destroy it, we\u2019ll
      never leave!"
  - speaker: Alice
    line: "That\u2019s exactly why I didn\u2019t want you to destroy it!"
  - speaker: Hazil
    line: What?! What do you mean? I thought you wanted to leave this place?
  - speaker: Alice
    line: "That\u2019s why I lied to you. I just wanted to lock you here\u2026 to
      keep you as my friend."
  - speaker: Alice
    line: "I deliberately left you behind, hoping you\u2019d give up. But you survived
      every trial, met those people, and found ways to escape."
  - speaker: Alice
    line: "Hahaha\u2026 but no matter what, I\u2019ll keep you here!"
  - speaker: Hazil
    line: "Alice\u2026 don\u2019t tell me\u2026 you\u2019re the one behind all this
      nightmare?"
  - speaker: Alice
    line: Took you long enough to figure it out.
  - speaker: Hazil
    line: "Don\u2019t do this, Alice. I know there\u2019s still good in you."
  - speaker: Alice
    line: "Sorry, Hazil\u2026 but this is where it ends for you."
  - speaker: Hazil
    line: ?!
  - speaker: Alice
    line: '!!!'
  - speaker: Hazil
    line: What?
  - speaker: Cecilia
    line: Run now!
