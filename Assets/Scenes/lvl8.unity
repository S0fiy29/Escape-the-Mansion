  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'The Hayes Mansion is renowned for its grandeur and impeccable upkeep,
    thanks to the many dedicated maids, butlers, and staff who have served the estate
    over the years. Each member of the staff carried out their duties with unwavering
    loyalty, ensuring the mansion remained a symbol of elegance and prestige.


    Beyond
    their roles in maintaining the mansion, they also showed genuine care and affection
    for the Hayes children, treating them with kindness and devotion. Their commitment
    to the family extended far beyond their obligations, reflecting a deep bond that
    defined their service.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
  m_sharedMaterial: {fileID: -6467807135178674435, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
