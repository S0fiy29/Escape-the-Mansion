--- !u!114 &65882275
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 65882274}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 37171f0ed2d9d3f49b2194e5c650a179, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 847734999}
  npcDialogueText: {fileID: 1150656815}
  playerDialoguePanel: {fileID: 1214466082}
  playerDialogueText: {fileID: 1857795977}
  dialogue:
  - speaker: Elana
    line: ' I think this is it. The next floor... we should be able to meet Mr. Jacob.'
  - speaker: Hazil
    line: "Yeah, I\u2019m getting goosebumps just thinking about it. What kind of
      person is he?"
  - speaker: Elana
    line: "He can be strict with the staff, but he\u2019s also a kind person when
      you get to know him."
  - speaker: Hazil
    line: "I see. Well, if you\u2019re with me, maybe it\u2019ll be easier to get
      him to talk."
  - speaker: Elana
    line: "Jeez, I\u2019m not here to play the middleman for your questions, you
      know."
  - speaker: Hazil
    line: "Haha, sorry about that. I just can't wait to ask him a lot of things\u2014"
  - speaker: Hazil
    line: "Like what\u2019s really going on in this mansion, why there are so many
      strange occurrences, and most importantly... who is Alice?"
  - speaker: Elana
    line: "I hope you find your answers, Hazil. Let\u2019s go."
  npcContButton: {fileID: 693369979}
  playerContButton: {fileID: 389582462}
  wordSpeed: 0.05
  playerMovement: {fileID: 2122463397}
  inventoryButton: {fileID: 225225054}
  pauseButton: {fileID: 1617265747}
