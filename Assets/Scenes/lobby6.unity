--- !u!114 &2122463392
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2122463391}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f13ca54006115e24bb77c1d39ff869a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 2051945749}
  npcDialogueText: {fileID: 1017341619}
  playerDialoguePanel: {fileID: 1135360910}
  playerDialogueText: {fileID: 409880773}
  dialogue:
  - speaker: Hazil
    line: Finally, some light on this floor! At least we won't have to worry about
      the "Shadow" lurking around here.
  - speaker: Elana
    line: You're right. It's a relief... But something about this place feels familiar
      to me.
  - speaker: Hazil
    line: Wait, have you been here before?
  - speaker: Elana
    line: I can't remember clearly, but this layout... If I'm not mistaken, we're
      close to the main lobby of the mansion.
  - speaker: Hazil
    line: The main lobby? That means we're nearing the heart of the mansion! We might
      finally get a chance to meet Mr. Jacob.
  - speaker: Elana
    line: Yeah... I just hope everything goes smoothly from here.
  npcContButton: {fileID: 1985345933}
  playerContButton: {fileID: 717061385}
  wordSpeed: 0.05
  playerMovement: {fileID: 2122463397}
  isTyping: 0
  inventoryButton: {fileID: 225225054}
  pauseButton: {fileID: 1617265747}
