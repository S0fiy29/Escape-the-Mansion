  m_Script: {fileID: 11500000, guid: 550e963110d6b014295bf513f00c9cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 109181670}
  npcDialogueText: {fileID: 25841587}
  playerDialoguePanel: {fileID: 185600692}
  playerDialogueText: {fileID: 130457546}
  dialogue:
  - speaker: Hazil
    line: Why are there two beds in this room?
  - speaker: Elana
    line: I'm not sure... I've never seen these beds before. Maybe they belong to
      Milady?
  - speaker: Hazil
    line: Belong to Milady? But why would she need two beds?
  - speaker: Elana
    line: Hmm, maybe she likes to combine them into one larger bed?
  - speaker: Hazil
    line: That doesn't make much sense. If she wanted a bigger bed, she could have
      just bought a large one instead of using two single beds.
  - speaker: Elana
    line: You have a point... It's strange. Maybe we can ask Milady if we ever find
      her.
  - speaker: Hazil
    line: Yeah... though I'm starting to feel like there's more to this than just
      extra bedding. I wonder if something is hidden here.
  - speaker: Elana
    line: "Well, there doesn\u2019t seem to be anything out of the ordinary here.
      Let\u2019s move on to the next floor. I\u2019ll wait for you by the door."
  - speaker: Hazil
    line: "Alright. I\u2019ll take one last look around this room before I join you."
  npcContButton: {fileID: 1057519531}
  playerContButton: {fileID: 1782641250}
