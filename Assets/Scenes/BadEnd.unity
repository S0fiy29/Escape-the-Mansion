--- !u!114 &92528805
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 92528800}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 525800c4e570e7748932a5cce015b259, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 636159279}
  npcDialogueText: {fileID: 485434102}
  playerDialoguePanel: {fileID: 1518523159}
  playerDialogueText: {fileID: 1832322705}
  dialogue:
  - speaker: Hazil
    line: "Alice... What\u2019s the meaning of this? We just returned to the basement!"
  - speaker: Alice
    line: "Of course we did. What\u2019s wrong with that?"
  - speaker: Hazil
    line: "(gasping) Alice... Don\u2019t tell me you\u2019ve been trying to trap
      me here all along."
  - speaker: Alice
    line: "Hahaha! Took you long enough to figure it out. Honestly, you\u2019re so
      pathetic."
  - speaker: Hazil
    line: "Alice! Why? I don\u2019t understand! You said you wanted to leave this
      place."
  - speaker: Hazil
    line: Did you lie to me about that?!
  - speaker: Alice
    line: "That\u2019s right. I lied. Even if part of me wanted to leave, the truth
      is... I prefer staying here."
  - speaker: Alice
    line: I can play with everyone, endlessly, forever.
  - speaker: Hazil
    line: "Alice... you\u2019re not thinking straight. Open your eyes\u2014there\u2019s
      nothing here to play with!"
  - speaker: Alice
    line: "What are you talking about, Hazil? I can just play with you, the same
      way I\u2019ve played with everyone else who foolishly came here."
  - speaker: Hazil
    line: "Please, Alice! Don\u2019t do this to me. Let me go..."
  - speaker: Alice
    line: "I can\u2019t, Hazil. That wouldn\u2019t be any fun. Even if you die here,
      your soul will stay\u2014just like everyone else in this mansion."
  - speaker: Alice
    line: And if they start to suspect anything, I can easily manipulate their memories.
  - speaker: Hazil
    line: '!!!'
  - speaker: Alice
    line: "Don\u2019t worry, Hazil. We\u2019ll take good care of you. It\u2019ll
      be our happy ending together."
  - speaker: Alice
    line: Hahaha!
  npcContButton: {fileID: 168262663}
  playerContButton: {fileID: 1290691877}
  wordSpeed: 0.05
  playerMovement: {fileID: 1126946610}
  gameOverPanel: {fileID: 1130578075}
