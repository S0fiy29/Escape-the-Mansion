  m_Script: {fileID: 11500000, guid: e1bb02c8da6200b48aeb104391660cbd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1513622225}
  npcDialogueText: {fileID: 41467898}
  playerDialoguePanel: {fileID: 1590159780}
  playerDialogueText: {fileID: 2006434281}
  dialogue:
  - speaker: Alice
    line: Mister, I think I need to stay here. Up ahead, there are shadows.
  - speaker: Hazil
    line: How do you even know that? I can't see any shadows from here.
  - speaker: Alice
    line: It's just a feeling I have.
  - speaker: Hazil
    line: Sometimes, it's hard to believe that your feelings can sense these shadows.
  - speaker: Alice
    line: Well, at least I warned you in advance.
  npcContButton: {fileID: 1265794378}
  playerContButton: {fileID: 545956361}
