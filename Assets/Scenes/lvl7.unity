--- !u!114 &331263773
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 331263772}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1bb02c8da6200b48aeb104391660cbd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1251026096}
  npcDialogueText: {fileID: 1568836653}
  playerDialoguePanel: {fileID: 670738187}
  playerDialogueText: {fileID: 1256912224}
  dialogue:
  - speaker: Alice
    line: Mister, why did you take so long? I've been tired of waiting for you forever!
  - speaker: Alice
    line: I was worried you might've faced some unknown incident while I waited here
      for you.
  - speaker: Hazil
    line: What? Waiting for me so long? Didn't I just see you in that room earlier?
  - speaker: Alice
    line: ...What do you mean, Mister? I've been waiting here the entire time without
      going anywhere.
  - speaker: Alice
    line: Are you okay, Mister? Did you hit your head on something?
  - speaker: Hazil
    line: (thinking) (Is her memory getting worse? This could be dangerous.)
  - speaker: Hazil
    line: No, no, it's nothing. I just slipped on my way here, and I must've gotten
      confused. I thought I saw you somewhere else.
  - speaker: Alice
    line: Hmm... strange. If you died from slipping, there'd be nothing I could do
      about it.
  - speaker: Alice
    line: But as long as you're alive, it's fine.
  - speaker: Hazil
    line: (thinking) (Her personality seems to be getting more aggressive for some
      reason.)
  - speaker: Hazil
    line: (nervous laugh) Haha... I'll be more careful, I promise.
  npcContButton: {fileID: 1358495627}
  playerContButton: {fileID: 121771953}
  wordSpeed: 0.05
  playerMovement: {fileID: 302511516}
  npcManager: {fileID: 0}
  disable: {fileID: 0}
  enable: {fileID: 0}
  toActive: {fileID: 0}
  toDeactive: {fileID: 0}
  inventoryButton: {fileID: 954409381}
  pauseButton: {fileID: 2138819939}
