--- !u!114 &2104173032
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2104173031}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1bb02c8da6200b48aeb104391660cbd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 325393386}
  npcDialogueText: {fileID: 733281092}
  playerDialoguePanel: {fileID: 1203946969}
  playerDialogueText: {fileID: 584220541}
  dialogue:
  - speaker: Hazil
    line: Alice? I thought you were waiting for me at the gate. How did you even
      get in here?
  - speaker: Cecilia
    line: ...I was just wandering around a bit. Then I noticed the door was open,
      so I went inside. After I entered, it closed behind me.
  - speaker: Hazil
    line: "Huh? The door can open and close on its own? That\u2019s strange."
  - speaker: Hazil
    line: "But I guess I can\u2019t blame you; this whole mansion is bizarre."
  - speaker: Cecilia
    line: What do you mean by me waiting at the gate?
  - speaker: Hazil
    line: You said you'd wait for me at the gate after I got the key, remember?
  - speaker: Cecilia
    line: Oh, right... I must've forgotten about that.
  - speaker: Hazil
    line: (Is her memory being manipulated? This is getting quite dangerous...)
  - speaker: Hazil
    line: Well, it's fine. Let's just stick together for now.
  - speaker: Cecilia
    line: Okay...
  npcContButton: {fileID: 183982207}
  playerContButton: {fileID: 133996505}
  wordSpeed: 0.05
  playerMovement: {fileID: 302511516}
  npcManager: {fileID: 757190497}
  disable: {fileID: 0}
  enable: {fileID: 0}
  toActive: {fileID: 37814706}
  toDeactive: {fileID: 1667897575}
  inventoryButton: {fileID: 954409381}
  pauseButton: {fileID: 2138819939}
