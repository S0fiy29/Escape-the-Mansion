--- !u!114 &1667897576
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1667897575}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 550e963110d6b014295bf513f00c9cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1445476832}
  npcDialogueText: {fileID: 1336606057}
  playerDialoguePanel: {fileID: 1065202060}
  playerDialogueText: {fileID: 64817936}
  dialogue:
  - speaker: Alice
    line: Hazil, I'll be waiting for you at the gate when you're finished.
  - speaker: Hazil
    line: Are you sure about that? It's quite dangerous to be alone in this place.
  - speaker: Alice
    line: It's fine. I've already memorized the floor plan, so there's no need to
      worry.
  - speaker: Hazil
    line: Even if you've memorized it, you still need someone to look out for you.
      This place can be unpredictable
  - speaker: Alice
    line: Don't worry. I'll just stick to areas with plenty of light. I'll be fine.
  - speaker: Hazil
    line: You know, I sometimes wonder how you manage to survive all this on your
      own.
