  m_Script: {fileID: 11500000, guid: 550e963110d6b014295bf513f00c9cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 949245569}
  npcDialogueText: {fileID: 1718037306}
  playerDialoguePanel: {fileID: 1595205087}
  playerDialogueText: {fileID: 497925212}
  dialogue:
  - speaker: Cecilia
    line: Mister, I'll wait for you at the gate.
  - speaker: Hazil
    line: ??? Huh? Are you sure about that? Last time you said you'd wait at the
      gate, but I found you wandering around in that room.
  - speaker: Cecilia
    line: Well... it was just my curiosity that got the better of me and made me
      wander around.
  - speaker: Cecilia
    line: But this time, I promise I'll meet you at the gate.
  - speaker: Hazil
    line: Huh... alright. I'll meet you there.
  - speaker: Cecilia
    line: Thanks, Mister.
