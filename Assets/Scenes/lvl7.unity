  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "To unlock the vault, solve this riddle:\n\nThe first digit counts the
    <color=#da01e8>true</color> members of the Hayes family, not what you\u2019ve
    been told.\n\nThe second digit reveals the keepers of notes, their identities
    unknown, but their <color=#da01e8>numbers</color> not so secret.\n\nThe third
    digit tells the story of survival, how many <color=#da01e8>remain</color> of
    those who record history.\n\nThe fourth digit is the <color=#da01e8>number</color>
    of precious antiques once displayed at the hayes hall.\n\nFind the answers and
    piece together the code to reveal what the vault hides within."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
