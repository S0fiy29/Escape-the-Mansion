  npcManager: {fileID: 0}
  dialogue:
  - speaker: Alice
    line: 'You really solved this puzzle floor, sir. Even my family struggled with
      it. '
  - speaker: Alice
    line: "I\u2019m shocked... You're different from anyone else."
  - speaker: Hazil
    line: What do you mean by that? Wait, does that mean other people have been here
      before me?
  - speaker: Alice
    line: "That\u2019s a secret. I can\u2019t tell you more than that."
  - speaker: Hazil
    line: "(She\u2019s being really secretive... Something feels off here.)"
  - speaker: Alice
    line: "Let\u2019s go, mister. We can\u2019t waste any more time here."
  - speaker: Hazil
    line: "Alright, let\u2019s get moving. We need to leave this floor."
