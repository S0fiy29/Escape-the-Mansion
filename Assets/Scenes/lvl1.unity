  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "To those who venture beyond this point,\n\nKnow that we were not the first
    to explore these halls. There were others\u2014people who came before us, seeking
    answers, just like you. Investigators, explorers, even skeptics... all drawn
    by the mansion's dark mysteries.\n\nThey wandered these rooms, searching for
    the truth. But one by one, they disappeared\u2014swallowed by the very secrets
    they sought to uncover. No trace of them remains, and no one knows if they ever
    made it out.\n\nWe can only assume they are still here, somewhere... trapped,
    like the rest of us. If you\u2019re reading this, be cautious. This place has
    a way of consuming those who overstep their bounds.\n\nDon\u2019t make the same
    mistake.\n\n\n- A Former Investigator"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
