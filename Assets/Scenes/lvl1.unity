  m_Script: {fileID: 11500000, guid: e725e63dc7c20fa499ff9eefb30ad29d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 2095034479}
  npcDialogueText: {fileID: 1737217027}
  playerDialoguePanel: {fileID: 1316694670}
  playerDialogueText: {fileID: 1471233549}
  npcManager: {fileID: 1501899932}
  dialogue:
  - speaker: Hazil
    line: Whoa! Who... who are you?
  - speaker: Alice
    line: I'm Alice.
  - speaker: Hazil
    line: How did you get in here? I just unlocked this door...
  - speaker: Alice
    line: I was waiting for you.
  - speaker: Hazil
    line: Waiting... for me? But I've never seen you before. Why are you here?
  - speaker: Alice
    line: "I\u2019m here because you needed to find me."
  - speaker: Hazil
    line: What do you mean? Who sent you?
  - speaker: Alice
    line: "No one sent me. I\u2019ve always been here."
  - speaker: Hazil
    line: "This doesn\u2019t make any sense..."
  - speaker: Hazil
    line: Look, you shouldn't be here. It's dangerous. We need to get out of this
      place.
  - speaker: Alice
    line: "Maybe... but you can\u2019t leave without me."
