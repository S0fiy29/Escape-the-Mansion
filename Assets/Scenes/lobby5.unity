  npcDialogueText: {fileID: 302737764}
  playerDialoguePanel: {fileID: 1402745206}
  playerDialogueText: {fileID: 267090}
  dialogue:
  - speaker: Hazil
    line: "We barely made it through that floor. Not gonna lie, if we had made a
      mistake, we could\u2019ve been stuck there forever."
  - speaker: Elana
    line: It was thanks to your skills that we solved those puzzles.
  - speaker: Hazil
    line: Well, no problem. But at least this place has some light. Maybe we can
      relax a bit, just for a moment.
  - speaker: Hazil
    line: "(looking around) Let\u2019s take a look around, though. There might be
      something important hidden here."
  - speaker: Elana
    line: "(nodding) Alright, I\u2019ll help you search. Let's be thorough."
