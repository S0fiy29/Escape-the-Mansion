MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1469178231}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 550e963110d6b014295bf513f00c9cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcDialoguePanel: {fileID: 1797672787}
  npcDialogueText: {fileID: 339156253}
  playerDialoguePanel: {fileID: 1248452378}
  playerDialogueText: {fileID: 1884971039}
  dialogue:
  - speaker: Hazil
    line: What is this room? It has four antique chairs.
  - speaker: Elana
    line: If I'm not mistaken, these chairs belonged to the Hayes family.
  - speaker: Hazil
    line: The Hayes family? Then why are they just stored here?
  - speaker: Elana
    line: That, I don't know. They were placed here on Mr. Hayes' orders. We were
      simply told to store them, but no one ever explained why.
  - speaker: Hazil
    line: This is strange... (Why would they store these chairs here?)
  - speaker: Elana
    line: "But there\u2019s something else that\u2019s odd. Why are there four chairs?
      The Hayes family only had three members, didn\u2019t they?"
  - speaker: Hazil
    line: "What? Three people? (Wait, something\u2019s not adding up...)"
  - speaker: Hazil
    line: I thought the Hayes family had four people?
  - speaker: Elana
    line: Four people? I think you're mistaken, Hazil. There were only three in the
      family.
  - speaker: Elana
    line: Are you alright, Hazil?
  - speaker: Hazil
    line: "(Something's definitely off here. I need to stay quiet for now.) Yeah,
      I'm fine. I must\u2019ve mixed something up."
  npcContButton: {fileID: 1495885029}
  playerContButton: {fileID: 1082056826}
  wordSpeed: 0.05
  playerIsClose: 0
  isDialogueActive: 0
  playerMovement: {fileID: 225950841}
  isTyping: 0
