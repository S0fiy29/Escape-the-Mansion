      m_Calls: []
  m_text: "I met my miserable fate that day. When I woke up, everything had changed.
    No one remembered what happened. It was as if their memories had been altered\u2026
    or erased. I don\u2019t understand what\u2019s going on, but now, everyone calls
    me 'Milady' instead of my real name. Even my parents\u2026 they don\u2019t remember
    my name. My name is \u2014\n\r\n\n\n\n\u2014CC"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 79af5aa2d9f81be4080184a80363fcfc, type: 2}
