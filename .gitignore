# Unity project .gitignore
# The Library folder alone is several GB and is rebuilt by Unity, so it must never be committed.

# Folders generated by Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Generated by Unity during builds
/[Aa]ssets/Plugins/Editor/JetBrains*
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# IDE and generated project files (Unity recreates these)
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Keep .meta files: Unity needs them to keep references between assets.
# Keep Packages/manifest.json and Packages/packages-lock.json.
